<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>YouTubeOffline</AssemblyName>
    <RootNamespace>LocalTube</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\YouTubeOffline.ico</ApplicationIcon>
    <AssemblyTitle>YouTube Offline</AssemblyTitle>
    <Product>YouTube Offline</Product>
    <Version>0.5.17</Version>
    <AssemblyVersion>0.5.17.0</AssemblyVersion>
    <FileVersion>0.5.17.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2210.55" />
  </ItemGroup>
</Project>
